# ---- copy to .env, then fill the blanks ; never commit .env ----
#
# Fastest way: `pnpm setup:env` generates .env with fresh random secrets.
# Every value below that is left blank MUST be set before anything will start.
# That is deliberate - a default password is a password that reaches the VPS.

# ---- database ----
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
# pnpm setup:env rewrites this line with the generated password.
DATABASE_URL=postgres://charkha@localhost:5432/charkha

# ---- NASA FIRMS ----
# Free key, registration round-trip: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NOAA-20. Do NOT use VIIRS_SNPP_NRT: NASA retires Suomi-NPP product delivery
# on 2026-11-01. VIIRS_NOAA21_NRT also works and returns fewer detections here.
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_BBOX=73.8,29.5,77.5,32.2
# Five, the FIRMS maximum. Measured 2026-09-12: a 1-day window returned ZERO
# detections over this bbox and 2 days had dropped from 18 lots to 13 overnight.
# Five days is the robust setting and the UI states the window out loud.
# NOTE: changing this file does NOT change a deployed .env - update the box too.
FIRMS_DAY_RANGE=5

# ---- agent-to-agent auth ----
# Shared secret used to mint and verify agent JWTs. Rotate before the demo.
# Generate: openssl rand -hex 32
A2A_JWT_SECRET=
A2A_JWT_ISSUER=charkha

# ---- agent base URLs (compose overrides these with service names) ----
PRODUCER_URL=http://localhost:4001
MATCHMAKER_URL=http://localhost:4002
VERIFIER_URL=http://localhost:4003
REGISTRY_URL=http://localhost:4004
GATEWAY_URL=http://localhost:4000
# Saathi, the assistant agent. Not one of the four that make decisions, so it
# is absent from the gateway's health check on purpose.
ASSISTANT_URL=http://localhost:4005
PUBLIC_BASE_URL=http://localhost:4000

# ---- deployment ----
# The public hostname Caddy serves and provisions TLS for. Leave BLANK locally
# (Caddy then serves plain :80). On the VM set it to the real hostname and also
# set PUBLIC_BASE_URL to https://<that hostname>.
# The field view's camera and WebGPU need a secure context, so the demo host
# must be HTTPS - see docs/DEPLOY.md.
CHARKHA_HOSTNAME=

# ---- registry signing key ----
# Ed25519 seed, 32-byte hex. Generate: pnpm -F @charkha/agent-registry keygen
# SERVER SIDE ONLY - never in a client bundle, a log line, or a commit.
REGISTRY_DID_SEED=

# ---- verifier model ----
ONNX_MODEL_PATH=./ml/models/char-quality.onnx
