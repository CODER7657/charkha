# ---- copy to .env ; never commit .env ----

# Postgres (docker-compose provides this by default)
DATABASE_URL=postgres://charkha:charkha@localhost:5432/charkha

# NASA FIRMS - free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace_me
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_BBOX=73.8,29.5,77.5,32.2
FIRMS_DAY_RANGE=2

# Shared secret used to mint/verify agent-to-agent JWTs. Rotate before demo.
A2A_JWT_SECRET=dev_only_change_me
A2A_JWT_ISSUER=charkha

# Agent base URLs (docker-compose overrides these with service names)
PRODUCER_URL=http://localhost:4001
MATCHMAKER_URL=http://localhost:4002
VERIFIER_URL=http://localhost:4003
REGISTRY_URL=http://localhost:4004
GATEWAY_URL=http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000

# Registry signing key (Ed25519 seed, 32-byte hex). Generate: pnpm -F @charkha/agent-registry keygen
# SERVER SIDE ONLY - never ship in a client bundle.
REGISTRY_DID_SEED=

# Verifier model
ONNX_MODEL_PATH=./ml/models/char-quality.onnx
