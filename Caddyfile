# The hostname comes from CHARKHA_HOSTNAME in .env, so deploying does not mean
# editing this file on the box at 3am.
#
#   CHARKHA_HOSTNAME=charkha-hashhawks.centralindia.cloudapp.azure.com
#
# Caddy obtains and renews the certificate itself. No certbot, no cron.
#
# Left blank, compose substitutes :80, which is fine for a local `docker compose up`
# and NOT fine for the demo: the field view needs a secure context for the
# camera and WebGPU, so over plain HTTP capture silently does nothing.
{$CHARKHA_HOSTNAME} {
	encode gzip

	# Agents and the gateway are never exposed directly - an open gateway is an
	# unauthenticated write endpoint. Only 80 and 443 are open on the VM.
	reverse_proxy gateway:4000
}
